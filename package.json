{
  "name": "claude-code-studio",
  "version": "0.14.0",
  "description": "CC Deck — an offline desktop companion for Claude Code: search your history, edit it, and share it.",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "tsx tests/smoke.mjs && tsx tests/edit_smoke.mjs && tsx tests/edit_roundtrip_smoke.mjs && tsx tests/title_smoke.mjs && tsx tests/group_smoke.mjs && tsx tests/resume_smoke.mjs && tsx tests/browse_load_smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "dompurify": "^3.4.16",
    "lossless-json": "4.3.1",
    "marked": "^18.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  }
}
